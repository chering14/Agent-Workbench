# Local Teams v2: no application login. Keep this file on your machine.
APP_HOST=127.0.0.1
APP_PORT=8765
TEAM_DATA_DIR=var/team

# Optional: on a fresh database, a non-empty LLM_MODEL creates one real member.
# After first launch, use the Members page to add or edit configurations.
# /chat/completions is appended to LLM_BASE_URL. Model must support tool calling.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Variable names to reference in the Members / MCP UI.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
MCP_ACCESS_TOKEN=

# Price, capability tier, output limit and task budget are configured in the UI.
# After changing environment values, restart the local server.
# Historical v1 commands have separate settings; see docs/legacy/DELIVERY-v1.md.
