# demo = transparent rule-based demo; live = real OpenAI-compatible tool calling.
APP_MODE=demo
APP_DB_PATH=var/agent_workbench.db
APP_HOST=127.0.0.1
APP_PORT=8765
APP_SEED_DEMO=true
APP_COOKIE_SECURE=false
APP_SESSION_HOURS=12

# Required only for live mode. /chat/completions is appended to LLM_BASE_URL.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_CALLS=8
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TOKEN_BUDGET=16000
LLM_RUN_TIMEOUT_SECONDS=120
LLM_REVIEW_ENABLED=true
# Optional prices per one million tokens; blank means cost is unknown.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# For APP_SEED_DEMO=false, first startup requires bootstrap credentials.
# Use a strong unique password of at least 12 characters.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_TENANT=acme
